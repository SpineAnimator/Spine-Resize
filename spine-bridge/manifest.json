{
  "manifest_version": 3,
  "name": "Spine Resize Bridge",
  "version": "1.3.0",
  "description": "Spine Resize Bridge and secure Spine Mask Tool project roundtrip",
  "permissions": [
    "activeTab",
    "nativeMessaging",
    "storage"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Spine Bridge"
  },
  "content_scripts": [
    {
      "matches": [
        "https://spineanimator.github.io/Spine-Resize/*",
        "http://localhost/*",
        "file:///*"
      ],
      "js": [
        "content.js"
      ]
    },
    {
      "matches": [
        "https://spineanimator.github.io/Spine-Mask-Tool/*"
      ],
      "js": [
        "mask-content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icon_16.png",
    "48": "icon_48.png",
    "128": "icon_128.png"
  }
}
